# Binaries
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
# Delve debug builds (e.g. cmd/http/__debug_bin3015032072)
__debug_bin*

# Test & coverage
*.test
*.out
coverage.*
*.coverprofile

# Go workspace
go.work
go.work.sum

# Vendor (uncomment if not committing vendored deps)
# /vendor/

# Environment & secrets
.env
.env.*
!.env.example

# Logs & temp
*.log
tmp/

# Vite cache, e.g. when a dev server is started from the repo root instead of web/
.vite/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Local config (copied from config.yaml.example)
/config.yaml

# Local SQLite database
*.db
*.db-shm
*.db-wal
