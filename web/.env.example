# Copy to .env and adjust. Only this example is committed; every other env file is git-ignored:
#   .env                    loaded by `npm run dev` and `npm run build`
#   .env.development        only `npm run dev`
#   .env.production         only `npm run build`
#   .env.*.local            per-machine overrides on top of the above

VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8000
