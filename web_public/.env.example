# Copy to .env and adjust. Only this example is committed.

# The demo of the admin panel behind every "Coba demo" button. Leave empty to hide them.
# Locally: the admin app's dev server (cd web && npm run dev). In production: the demo's URL.
VITE_DEMO_URL=http://localhost:5173
# The demo TV display, shown under "Layar TV" in Coba demo. Empty: the demo URL + /tv.
VITE_DEMO_TV_URL=
