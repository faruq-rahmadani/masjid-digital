# Local development: cp config.yaml.example config.yaml
# Production (ENV=production): /etc/masjid-digital-config/config.yaml

app:
  name: masjid-digital

  http_server:
    listen_address: 0.0.0.0
    port: "3000"
    graceful_timeout: 30s
    read_timeout: 30s
    write_timeout: 30s
    idle_timeout: 120s

  logger:
    level: debug
    debug: true

client: {}
