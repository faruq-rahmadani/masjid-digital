# Copy to .env next to docker-compose.yml

# Signs login tokens, at least 32 bytes. Generate one with: openssl rand -base64 32
# Changing it logs everyone out.
JWT_SECRET=

# Password of the Postgres user; letters and digits only, it goes into a connection URL.
# Generate one with: openssl rand -hex 24
DB_PASSWORD=

# Where the app is served. 127.0.0.1 keeps it for a reverse proxy on this server;
# 0.0.0.0 opens it to the network, e.g. TVs on the mosque's LAN without a proxy.
LISTEN=127.0.0.1
PORT=8080

# Image tag to run, e.g. v1.2.0; latest when unset
VERSION=latest
